    <worksheet name='latest 10day return'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Latest 10-Day Return</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_stock_prices (postgres)' name='federated.1qqi7ph092y19i1cjux8u1iohff5' />
          </datasources>
          <datasource-dependencies datasource='federated.1qqi7ph092y19i1cjux8u1iohff5'>
            <column caption='10‑Day Return' datatype='real' name='[Calculation_1295328723853313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([close]) - LOOKUP(SUM([close]), -10))&#10;/&#10;LOOKUP(SUM([close]), -10)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Latest 10-Day Return' datatype='real' name='[Calculation_1295328725266434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST() = 0 THEN 10-[Calculation_1295328723853313] END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption=' Is Latest Row' datatype='boolean' name='[Calculation_1295328750661642]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
