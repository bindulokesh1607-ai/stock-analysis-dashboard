      <aliases enabled='yes' />
      <column caption='Daily Return' datatype='real' name='[Calculation_0926373549182976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([close]) - LOOKUP(SUM([close]), -1)) / LOOKUP(SUM([close]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MA10' datatype='real' name='[Calculation_0926373550006273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([close]), -9, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest Close' datatype='real' name='[Calculation_1295328721465344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN SUM([close]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='10‑Day Return' datatype='real' name='[Calculation_1295328723853313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([close]) - LOOKUP(SUM([close]), -10))&#10;/&#10;LOOKUP(SUM([close]), -10)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest 10-Day Return' datatype='real' name='[Calculation_1295328725266434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN 10-[Calculation_1295328723853313] END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption=' Is Latest Row' datatype='boolean' name='[Calculation_1295328750661642]' role='measure' type='nominal'>
